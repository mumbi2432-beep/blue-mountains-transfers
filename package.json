{
	"name": "nepali-property-market",
	"description": "Programmatic-SEO directory of Nepali-speaking property professionals in Australia.",
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"astro": "5.16.2",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"wrangler": "4.56.0"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"cf-typegen": "wrangler types",
		"check": "astro build && tsc && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && wrangler dev",
		"db:migrate:local": "wrangler d1 migrations apply nepali-property-market --local",
		"db:migrate:remote": "wrangler d1 migrations apply nepali-property-market --remote",
		"db:seed-demo:local": "wrangler d1 execute nepali-property-market --local --file=db/seed-demo.sql",
		"typecheck": "astro check || tsc --noEmit"
	},
	"type": "module"
}
